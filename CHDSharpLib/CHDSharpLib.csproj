<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
        <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
        <IsPackable>true</IsPackable>
        <RootNamespace>CHDSharp</RootNamespace>
    </PropertyGroup>
    <PropertyGroup>
        <PackageId>CHDSharp</PackageId>
        <Authors>Peterson Fernandes</Authors>
        <Description>Pure C# CHD (Compressed Hunks of Data) reader and writer library. Supports MAME CHD formats V1-V5, all 10 compression codecs (zlib, lzma, huffman, flac, zstd, avhu + CD variants), and full CHD creation/encoding with chdman-compatible output.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>chd.png</PackageIcon>
        <PackageTags>chd;mame;compression;emulation;disk-image;zstd;lzma;flac;huffman;avhuff</PackageTags>
        <PackageProjectUrl>https://github.com/purelogiccode/CHDSharp</PackageProjectUrl>
        <RepositoryUrl>https://github.com/purelogiccode/CHDSharp</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
        <PackageLicenseExpression></PackageLicenseExpression>
        <PackageReleaseNotes>v1.7.3: Tooling release. The CLI is also published as the CHDSharp.Cli .NET tool, Windows bundles have winget manifests, and CI now packs and verifies both NuGet packages, checks the tool layout for net8.0/net9.0/net10.0/net11.0, and smoke-installs the tool. The logger-capture tests are serialized. No public API or encoder output changes: 4,223 library tests + 456 encoder tests on each target framework, jb inspectcode 0 findings, CI chdman parity smoke passed. Pure C# - zero native dependencies. Targets net8.0/net9.0/net10.0/net11.0.</PackageReleaseNotes>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    </PropertyGroup>
    <PropertyGroup>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Meziantou.Analyzer" Version="3.0.342">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="11.0.100" PrivateAssets="All" />
        <PackageReference Include="Roslynator.Analyzers" Version="5.0.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="System.IO.Hashing" Version="11.0.0" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="CHDSharpTest" />
        <InternalsVisibleTo Include="CHDSharpTestDataGeneration" />
        <InternalsVisibleTo Include="CHDSharpEncoderTest" />
    </ItemGroup>
    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
        <None Include="LICENSE.txt" Pack="true" PackagePath="\" />
        <None Include="Icon\chd.png" Pack="true" PackagePath="\" />
    </ItemGroup>
    <ItemGroup>
        <None Remove="References\**" />
    </ItemGroup>
    <ItemGroup>
        <Compile Remove="References\**" />
    </ItemGroup>
    <ItemGroup>
        <Page Remove="References\**" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\VendoredZLib\VendoredZLib.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\VendoredLZMA\VendoredLZMA.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\VendoredFlac\VendoredFlac.csproj" PrivateAssets="all" />
        <ProjectReference Include="..\VendoredZSTD\VendoredZSTD.csproj" PrivateAssets="all" />
    </ItemGroup>
    <Target Name="IncludeVendoredAssembliesInPackage" BeforeTargets="_GetPackageFiles">
        <ItemGroup>
            <_PackageFiles Include="..\VendoredZLib\bin\$(Configuration)\net8.0\VendoredZLib.dll">
                <PackagePath>lib\net8.0\VendoredZLib.dll</PackagePath>
            </_PackageFiles>
            <_PackageFiles Include="..\VendoredZLib\bin\$(Configuration)\net9.0\VendoredZLib.dll">
                <PackagePath>lib\net9.0\VendoredZLib.dll</PackagePath>
            </_PackageFiles>
            <_PackageFiles Include="..\VendoredZLib\bin\$(Configuration)\net10.0\VendoredZLib.dll">
                <PackagePath>lib\net10.0\VendoredZLib.dll</PackagePath>
            </_PackageFiles>
            <_PackageFiles Include="..\VendoredZLib\bin\$(Configuration)\net11.0\VendoredZLib.dll">
                <PackagePath>lib\net11.0\VendoredZLib.dll</PackagePath>
            </_PackageFiles>
            <_PackageFiles Include="..\VendoredLZMA\bin\$(Configuration)\net8.0\VendoredLZMA.dll">
                <PackagePath>lib\net8.0\VendoredLZMA.dll</PackagePath>
            </_PackageFiles>
            <_PackageFiles Include="..\VendoredLZMA\bin\$(Configuration)\net9.0\VendoredLZMA.dll">
                <PackagePath>lib\net9.0\VendoredLZMA.dll</PackagePath>
            </_PackageFiles>
            <_PackageFiles Include="..\VendoredLZMA\bin\$(Configuration)\net10.0\VendoredLZMA.dll">
                <PackagePath>lib\net10.0\VendoredLZMA.dll</PackagePath>
            </_PackageFiles>
            <_PackageFiles Include="..\VendoredLZMA\bin\$(Configuration)\net11.0\VendoredLZMA.dll">
                <PackagePath>lib\net11.0\VendoredLZMA.dll</PackagePath>
            </_PackageFiles>
            <_PackageFiles Include="..\VendoredFlac\bin\$(Configuration)\net8.0\VendoredFlac.dll">
                <PackagePath>lib\net8.0\VendoredFlac.dll</PackagePath>
            </_PackageFiles>
            <_PackageFiles Include="..\VendoredFlac\bin\$(Configuration)\net9.0\VendoredFlac.dll">
                <PackagePath>lib\net9.0\VendoredFlac.dll</PackagePath>
            </_PackageFiles>
            <_PackageFiles Include="..\VendoredFlac\bin\$(Configuration)\net10.0\VendoredFlac.dll">
                <PackagePath>lib\net10.0\VendoredFlac.dll</PackagePath>
            </_PackageFiles>
            <_PackageFiles Include="..\VendoredFlac\bin\$(Configuration)\net11.0\VendoredFlac.dll">
                <PackagePath>lib\net11.0\VendoredFlac.dll</PackagePath>
            </_PackageFiles>
            <_PackageFiles Include="..\VendoredZSTD\bin\$(Configuration)\net8.0\VendoredZSTD.dll">
                <PackagePath>lib\net8.0\VendoredZSTD.dll</PackagePath>
            </_PackageFiles>
            <_PackageFiles Include="..\VendoredZSTD\bin\$(Configuration)\net9.0\VendoredZSTD.dll">
                <PackagePath>lib\net9.0\VendoredZSTD.dll</PackagePath>
            </_PackageFiles>
            <_PackageFiles Include="..\VendoredZSTD\bin\$(Configuration)\net10.0\VendoredZSTD.dll">
                <PackagePath>lib\net10.0\VendoredZSTD.dll</PackagePath>
            </_PackageFiles>
            <_PackageFiles Include="..\VendoredZSTD\bin\$(Configuration)\net11.0\VendoredZSTD.dll">
                <PackagePath>lib\net11.0\VendoredZSTD.dll</PackagePath>
            </_PackageFiles>
        </ItemGroup>
    </Target>
    <ItemGroup>
        <Using Include="CHDSharp.Models" />
    </ItemGroup>
</Project>