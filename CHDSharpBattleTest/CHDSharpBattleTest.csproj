<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <RootNamespace>CHDSharpBattleTest</RootNamespace>
        <AssemblyName>CHDSharpBattleTest</AssemblyName>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\CHDSharpLib\CHDSharpLib.csproj" />
    </ItemGroup>
    <ItemGroup></ItemGroup>
    <ItemGroup>
        <Using Include="CHDSharpBattleTest.Models" />
        <Using Include="CHDSharp.Models" />
        <Using Include="CHDSharp.Encoder.Models" />
        <Using Include="CHDSharp.Encoder.Interfaces" />
    </ItemGroup>
    <ItemGroup>
      <PackageReference Update="Meziantou.Analyzer" Version="3.0.190">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
    </ItemGroup>
</Project>